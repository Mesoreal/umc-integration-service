# Скопируй в .env и заполни реальными значениями.# ═══════════════════════════════════════════════════════════════
# Не секретные настройки (amoCRM subdomain, id воронки/этапов/полей) —

#PostgreSQL (umc_user / umc_db)
SPRING_DATASOURCE_PASSWORD=

#RabbitMQ (umc_user)
SPRING_RABBITMQ_PASSWORD=

INTERNAL_API_KEY=

#Yandex Vision OCR
YANDEX_OCR_API_KEY=
YANDEX_FOLDER_ID=

#amoCRM OAuth2
AMOCRM_CLIENT_SECRET=
AMOCRM_REFRESH_TOKEN=
AMOCRM_WEBHOOK_SECRET=