# ═══════════════════════════════════════════════════════════════
# umc-integration-service — секреты для mesoreal-secrets
#
# НЕ для локального запуска сервиса — local/ в backend/ занимается этим отдельно.
# Это разовый стейджинг-файл: копируешь в .env, заполняешь реальными значениями
# на сервере, накатываешь через ./apply-secrets.sh и удаляешь.
#
# Имена ключей ниже — ровно те же, что в mesoreal-secrets (не имена Spring env
# vars) — apply-secrets.sh кладёт их 1-в-1, без переименования.
#
# Не секретные настройки (amoCRM subdomain, id воронки/этапов/полей) — НЕ сюда,
# они прямо в src/main/resources/application.yml.
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL (umc_user / umc_db) ──────────────────────────────
UMC_POSTGRES_PASSWORD=

# ── RabbitMQ (umc_user) ──────────────────────────────────────────
RABBITMQ_UMC_PASSWORD=

# ── Общий внутренний ключ (profile-service ↔ umc-integration-service) ─
# Обычно уже есть в mesoreal-secrets (общий с auth-service/phone-auth) —
# трогать не нужно, если не меняете его специально.
INTERNAL_API_KEY=

# ── Yandex Vision OCR ────────────────────────────────────────────
YANDEX_OCR_API_KEY=
YANDEX_FOLDER_ID=

# ── amoCRM OAuth2 ────────────────────────────────────────────────
AMOCRM_CLIENT_SECRET=
AMOCRM_REFRESH_TOKEN=
# Наш собственный секрет в пути вебхука, не то, что шлёт amoCRM.
AMOCRM_WEBHOOK_SECRET=
