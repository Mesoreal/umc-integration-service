# ═══════════════════════════════════════════════════════════════
# Mesoreal umc-integration-service — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Секреты и переменные окружения ──────────────────────────────
.env
.env.*
!.env.example

# ── Maven build артефакты ───────────────────────────────────────
target/
*.jar
*.war
*.ear
*.class
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# ── Локальный Maven-кэш в репо ──────────────────────────────────
.m2/

# ── IDE ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Логи ─────────────────────────────────────────────────────────
*.log
logs/

# ── Docker volumes (на случай локальных запусков) ───────────────
postgres_data/
redis_data/
traefik_certs/
